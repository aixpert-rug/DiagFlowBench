    box_12 -->|"Still low"| box_13
    box_12 -->|"OK"| box_16
    box_10 -->|"Yes"| box_16
    box_14 --> box_16
    box_15 --> box_16
    box_16 -->|"No"| box_17
    box_17 --> box_18
    box_16 -->|"Yes"| box_20
    box_18 --> box_20
