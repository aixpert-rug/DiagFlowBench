flowchart TD
    box_0(["Start"])
    box_1{"Does the part meet quality assurance team product<br/>specifications?"}
    box_2["Check the product for contamination and verify that<br/>its dimensions meet quality assurance<br/>specifications."]
    box_3["Remove the non conforming parts and reload with a<br/>product batch that meets quality assurance team<br/>specifications."]
    box_4{"Is transferring part from reorientation mechanism to<br/>output holder rack correct?"}
    box_5["Verify that parts remain properly seated in the<br/>fixtures after the reorientation mechanism turns.<br/>The reorientation mechanism must be parallel to the<br/>output holder rack and reach the correct end angle<br/>without causing parts to shift during lifting."]
    box_6[/"Part transfer from reorientation mechanism to output<br/>holder rack: diagnostic procedure reference."/]
    box_7{"Is the lowering of the output holder rack correct?"}
    box_8["Verify that the part transfer holder stands upright<br/>in its return position and that both sides lower<br/>evenly during descent."]
    box_9[/"Output holder rack lowering: diagnostic procedure<br/>reference."/]
    box_10{"Are there contaminated parts?"}
    box_11[/"Refer to the vacuum end effector condition check for<br/>variant A machines (small format parts)."/]
    box_12["Complete the following checks: 1. Check the assembly<br/>robot axes for contamination. 2. Check the guide<br/>axes and ball recirculation bushing of the vacuum<br/>end effectors for contamination."]
    box_13[/"Refer to the vacuum end effector condition check for<br/>variant B machines (medium format parts)."/]
    box_14[/"Refer to the vacuum end effector condition check for<br/>variant C machines (large format parts)."/]
    box_15["Clean the contaminated vacuum end effectors and<br/>robot components; replace any part with<br/>contamination related damage."]
    box_16[/"Assembly robot axis lubrication procedure"/]
    box_17{"Are there electrical defects?"}
    box_18["Complete the following checks: 1. Check cabling and<br/>upper displacement sensors on the vacuum end<br/>effectors. 2. Check the vacuum switches. 3. Check<br/>whether the valve for the vacuum generator works<br/>correctly. 4. Check system settings on the operator<br/>control interface."]
    box_19["Replace the defective cabling and/or displacement<br/>sensor on the vacuum end effectors."]
    box_20{"Are there worn parts?"}
    box_21["Complete the following checks: 1. Check wear on the<br/>vacuum end effectors. 2. Check wear on the actuator<br/>grippers. 3. Check wear on the guide axis through<br/>the ball recirculation bushing. 4. Check the<br/>assembly robot axes for wear."]
    box_22["Replace the worn components identified in the<br/>inspection (vacuum end effectors, actuator grippers,<br/>guide axis, and/or assembly robot axes)."]
    box_23[/"Assembly robot replacement procedure"/]
    box_24{"Are the vacuum end effectors at equal height in the<br/>lower position?"}
    box_25[/"Refer to the Z parallelism of 4x vacuum end effector<br/>lower position for variant A machines (small format<br/>parts)."/]
    box_26[/"Refer to the Z parallelism of 4x vacuum end effector<br/>lower position for variant B machines (medium format<br/>parts)."/]
    box_27[/"Refer to the Z parallelism of 4x vacuum end effector<br/>lower position for variant C machines (large format<br/>parts)."/]
    box_28["Readjust the Z height of the vacuum end effectors to<br/>achieve equal height at the lower position."]
    box_29{"Is the center to center dimension of 4x vacuum end<br/>effectors relative to each other correct?"}
    box_30[/"Refer to the center to center dimension of 4x vacuum<br/>end effectors for variant A machines (small format<br/>parts)."/]
    box_31[/"Refer to the center to center dimension of 4x vacuum<br/>end effectors for variant B machines (medium format<br/>parts)."/]
    box_32[/"Refer to the center to center dimension of 4x vacuum<br/>end effectors for variant C machines (large format<br/>parts)."/]
    box_33["Replace the vacuum end effector assembly that cannot<br/>be adjusted to the correct center to center<br/>dimension."]
    box_34{"Is the pick up position of 4x part from part holder<br/>correct?"}
    box_35[/"Refer to the Z height and XY placement position<br/>check for variant A machines (small format parts)."/]
    box_36[/"Refer to the Z height and XY placement position<br/>check for variant B machines (medium format parts)."/]
    box_37[/"Refer to the Z height and XY placement position<br/>check for variant C machines (large format parts)."/]
    box_38["Perform assembly robot calibrations to correct the Z<br/>height and XY pick up position from the part holder."]
    box_39["Restart this diagnostic procedure from the<br/>beginning."]
    box_40(["Placing 4x part in reorientation unit is correct"])

