flowchart TD
    box_0(["Start: height measurement of contact surface fixture"])
    box_1{"Does the product meet quality assurance team<br/>specifications?"}
    box_2["Note that the product thickness is outside<br/>specification, which will directly affect the height<br/>measurement reading."]
    box_3["Remove the non conforming products and reload with<br/>the correct product type before restarting the<br/>height measurement."]
    box_4{"Is the control for part lying flat (vacuum)<br/>functioning?"}
    box_5["Verify that the vacuum system correctly pulls and<br/>seats the part against the fixture."]
    box_6[/"Vacuum part present detection diagnostic"/]
    box_7{"Is placing part on insert correct?"}
    box_8["Verify that the part is mounted straight on the<br/>insert and is not tilted."]
    box_9[/"Insert placement diagnostic (GRAPH 10)"/]
    box_10{"Is the pressing part process functioning?"}
    box_11["Verify that the part is pressed at the correct<br/>stable speed straight into the insert, with no gap<br/>remaining."]
    box_12[/"Insert pressing diagnostic (GRAPH 11)"/]
    box_13{"Are the contact surfaces clean?"}
    box_14["Check the contact surfaces where the gauge touches<br/>in the lowest position of the pressing mechanism"]
    box_15["Clean the contact surfaces, including the gauge<br/>head."]
    box_16{"Is there a cable break or damage?"}
    box_17["Complete the following steps: 1. Carefully move the<br/>cables and check whether the reading on the operator<br/>control interface remains stable. 2. Physically<br/>inspect the cable for damage. 3. Replace the signal<br/>cable between gauge and amplifier if damaged."]
    box_18["Replace the damaged signal cable between the gauge<br/>and the amplifier."]
    box_19{"Is the amplifier correct?"}
    box_20["Inspect the amplifier unit for faults or damage."]
    box_21["Replace the faulty amplifier unit."]
    box_22{"Does the gauge move smoothly?"}
    box_23["Press the gauge and check for smooth movement<br/>without play"]
    box_24["Replace the gauge with a new one that moves smoothly<br/>and without play."]
    box_25{"Is the green accordion rubber damaged?"}
    box_26["Inspect the accordion rubber seal on the gauge for<br/>visible cracks or tears."]
    box_27["Replace the gauge assembly: the accordion rubber<br/>seal is damaged and cannot be repaired."]
    box_28{"Is the contact probe defective?"}
    box_29["Check contact probe for damage or looseness"]
    box_30["Replace contact probe or fasten it securely"]
    box_31{"Is the gauge loose?"}
    box_32["Check the clamping collar that clamps the gauge"]
    box_33["Fasten the clamping collar to secure the gauge in<br/>its correct position."]
    box_34{"Is the gauge correctly adjusted?"}
    box_35["Complete the following steps: 1. Move the gauge<br/>downward and the part fixture upward. 2. Place a<br/>gauge block of the specified thickness between them<br/>and check the indicated value on the operator<br/>control interface."]
    box_36[/"Refer to the gauge adjustment specification for<br/>variant A machines (small format parts)."/]
    box_37[/"Refer to the gauge adjustment specification for<br/>variant B machines (medium format parts)."/]
    box_38[/"Refer to the gauge adjustment specification for<br/>variant C machines (large format parts)."/]
    box_39[/"Gauge zeroing and adjustment procedure at pressing<br/>station"/]
    box_40["Measured values must correspond to the insertion<br/>depth value"]
    box_41(["The gauge is working correctly"])

