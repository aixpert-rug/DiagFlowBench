flowchart TD
    box_0(["Start"])
    box_1{"Do part and insert meet the required specifications?"}
    box_2["Check input material and quality specifications,<br/>note the thickness of the insert."]
    box_3["Remove the non conforming material and reload with<br/>parts and inserts that meet the required dimensional<br/>specifications."]
    box_4{"Is placing part on insert correct?"}
    box_5["Verify that the part is mounted straight on the<br/>insert and is not tilted."]
    box_6[/"Insert placement diagnostic (GRAPH 10)"/]
    box_7{"Is the pressing part process functioning?"}
    box_8["Verify that the part is pressed at the correct<br/>stable speed straight into the insert, with no gap<br/>remaining."]
    box_9[/"Insert pressing diagnostic (GRAPH 11)"/]
    box_10{"Is the control for part lying flat (vacuum)<br/>functioning?"}
    box_11["Verify that the vacuum system correctly pulls and<br/>seats the part against the fixture."]
    box_12[/"Vacuum part present detection diagnostic"/]
    box_13{"Is there a cable break on the force sensor?"}
    box_14["Move the cable and check whether the force reading<br/>on the operator control interface remains stable."]
    box_15["Replace the force sensor cable that shows the break<br/>or intermittent signal reading."]
    box_16{"Is the force sensor correctly calibrated?"}
    box_17["Using a separate force sensor meter, move the<br/>pressing heads downward and verify that the force<br/>reading on the operator control interface matches<br/>the meter reading."]
    box_18[/"Force sensor calibration procedure at pressing<br/>station"/]
    box_19["Confirm that the measured force values are within<br/>the control limits."]
    box_20(["The force measurement is correct"])

