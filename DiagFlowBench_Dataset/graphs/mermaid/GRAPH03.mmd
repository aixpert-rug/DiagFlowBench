flowchart TD
    box_0(["Start"])
    box_1{"Do all 8 parts fit correctly in or on the fixtures?"}
    box_2[/"Reference: play and burr inspection, part to fixture<br/>fit."/]
    box_3["Identify and replace the faulty fixture on the<br/>indexing table that is causing the incorrect part<br/>fit."]
    box_4{"Are the 8 fixtures themselves securely fastened?"}
    box_5["Fasten all fixtures securely to eliminate play in<br/>their seating on the indexing table."]
    box_6{"Is the height measurement at station 8 or 11<br/>properly adjusted?"}
    box_7[/"Station height measurement adjustment procedure"/]
    box_8["Measure the part gap dimensions at the relevant<br/>station using a caliper to determine the extent of<br/>the deviation."]
    box_9["Complete the following steps: 1. Remove all parts<br/>from the current batch. 2. Introduce a replacement<br/>input batch and perform a new full sample<br/>measurement. 3. Report non conforming parts via the<br/>team leader for escalation to the quality assurance<br/>team at shift handover."]
    box_10{"Gap now OK?"}
    box_11(["Notify quality assurance manager"])
    box_12(["Notify maintenance team / engineering team"])

    box_0 --> box_1
    box_2 --> box_1
    box_1 -->|"No"| box_3
    box_1 -->|"Yes"| box_4
    box_4 -->|"No"| box_5
    box_4 -->|"Yes"| box_6
    box_7 --> box_6
    box_6 -->|"No"| box_8
    box_6 -->|"Yes"| box_9
    box_9 --> box_10
    box_10 -->|"Yes"| box_11
    box_10 -->|"No"| box_12

