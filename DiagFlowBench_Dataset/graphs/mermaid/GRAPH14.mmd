flowchart TD
    box_0(["Start"])
    box_1{"Does the part meet product specifications?"}
    box_2["Check input parts for defect types: burrs,<br/>contamination, dents, or deformation."]
    box_3["Remove the non conforming parts from the indexing<br/>table and reload with a product batch that meets<br/>specifications."]
    box_4{"Is the setup of the indexing table correct?"}
    box_5[/"Indexing table setup procedure"/]
    box_6[/"Part mounting adjustment procedure"/]
    box_7[/"Indexing table setup procedure"/]
    box_8[/"Assembly robot axis lubrication procedure"/]
    box_9{"Are there contaminated parts?"}
    box_10["Complete the following checks: 1. Check whether<br/>vacuum end effectors are contaminated. 2. Check the<br/>vacuum filters for contamination. 3. Check whether<br/>the assembly robot axes are contaminated. 4. Check<br/>whether the part holders in the indexing table are<br/>contaminated."]
    box_11["Clean the parts, replace the vacuum filters, and<br/>replace the vacuum hose."]
    box_12[/"Pneumatic flow measurement procedure: vacuum flow<br/>check"/]
    box_13[/"Refer to the vacuum flow check for variant B<br/>machines (medium format parts)."/]
    box_14[/"Refer to the vacuum flow check for variant C<br/>machines (large format parts)."/]
    box_15{"Are there electrical defects?"}
    box_16["Complete the following checks: 1. Check cabling and<br/>upper displacement sensors on the vacuum end<br/>effectors. 2. Check whether the valve for the vacuum<br/>generator works correctly. 3. Check system settings<br/>on the operator control interface."]
    box_17["Replace the defective cabling and/or displacement<br/>sensor on the vacuum end effectors."]
    box_18[/"Refer to the vacuum switch function check for<br/>variant A machines (small format parts)."/]
    box_19[/"Refer to the vacuum switch function check for<br/>variant B machines (medium format parts)."/]
    box_20[/"Refer to the vacuum switch function check for<br/>variant C machines (large format parts)."/]
    box_21{"Are there worn parts?"}
    box_22["Complete the following checks: 1. Check wear on the<br/>vacuum end effectors. 2. Check wear on the actuator<br/>grippers. 3. Check wear on the gripper pin through<br/>the aluminium block. 4. Check the assembly robot<br/>axes for wear."]
    box_23["Replace the worn components identified in the<br/>inspection (vacuum end effectors, actuator grippers,<br/>gripper pin, and/or assembly robot axes)."]
    box_24[/"Assembly robot replacement procedure"/]
    box_25{"Is the part lying correctly in the holder?"}
    box_26["Check whether the black inserts in the indexing<br/>table are magnetic."]
    box_27["Demagnetize the black inserts in the indexing table."]
    box_28{"Is the Z parallelism of the lower position of 4x<br/>gripper correct?"}
    box_29[/"Refer to the Z parallelism check for gripper lower<br/>position for variant A machines (small format<br/>parts)."/]
    box_30[/"Refer to the Z parallelism check for gripper lower<br/>position for variant B machines (medium format<br/>parts)."/]
    box_31[/"Refer to the Z parallelism check for gripper lower<br/>position for variant C machines (large format<br/>parts)."/]
    box_32["Adjust the Z parallelism of the 4x gripper lower<br/>positions to match the specification for the current<br/>machine variant."]
    box_33{"Is the center to center dimension of 4x gripper<br/>relative to each other correct?"}
    box_34[/"Refer to the center to center dimension of 4x<br/>grippers for variant A machines (small format<br/>parts)."/]
    box_35[/"Refer to the center to center dimension of 4x<br/>grippers for variant B machines (medium format<br/>parts)."/]
    box_36[/"Refer to the center to center dimension of 4x<br/>grippers for variant C machines (large format<br/>parts)."/]
    box_37["Adjust the center to center spacing of the 4x<br/>grippers to match the specification for the current<br/>machine variant."]
    box_38{"Is the Z height correct?"}
    box_39[/"Refer to the Z height check for variant A machines<br/>(small format parts)."/]
    box_40[/"Refer to the Z height check for variant B machines<br/>(medium format parts)."/]
    box_41[/"Refer to the Z height check for variant C machines<br/>(large format parts)."/]
    box_42["Adjust the Z height of the 4x gripper assembly to<br/>match the specification for the current machine<br/>variant."]
    box_43{"Is the XY pick up position of part from indexing<br/>table correct?"}
    box_44[/"Refer to the XY pick up position check for variant A<br/>machines (small format parts)."/]
    box_45[/"Refer to the XY pick up position check for variant B<br/>machines (medium format parts)."/]
    box_46[/"Refer to the XY pick up position check for variant C<br/>machines (large format parts)."/]
    box_47[/"Pick up and placement adjustment procedure: part<br/>from indexing table"/]
    box_48["Perform assembly robot calibrations to correct the<br/>4x gripper XY pick up position from the indexing<br/>table."]
    box_49["Verify that the part is picked up centred and held<br/>firmly enough in the vacuum head."]
    box_50(["Picking up 4x part from indexing table is correct"])
    box_51["Verify that there is no play between the setup tool<br/>and the indexing table during mounting."]
    box_52[/"Refer to the vacuum flow check for variant A<br/>machines (small format parts), standard vacuum flow<br/>parameters apply; use the general pneumatic flow<br/>measurement procedure only, no variant specific flow<br/>calibration is required for small format parts."/]

