flowchart TD
    box_0(["Start"])
    box_1{"Does the input material meet quality specification?"}
    box_2["Check the quality of input material against the<br/>quality specification."]
    box_3["Remove the non conforming input material and reload<br/>with a batch that meets quality assurance team<br/>quality requirements."]
    box_4{"Is the indexing table correctly positioned?"}
    box_5["Check relative to 'part mounting inserts' whether<br/>the indexing table has not been rotated too far."]
    box_6[/"Indexing table setup procedure"/]
    box_7{"Is the part correctly placed on the insert?"}
    box_8["Verify that the part is lightly pressed into the<br/>insert and is seated without looseness or tilt."]
    box_9[/"Insert placement diagnostic (GRAPH 10)"/]
    box_10{"Is part mounting correct?"}
    box_11["Verify that the part is mounted straight and high<br/>enough: it must not be tilted on the fixture or<br/>still resting in the indexing table."]
    box_12[/"Insert placement pickup diagnostic (GRAPH 08)"/]
    box_13{"Is the vacuum detection 'tilted part control'<br/>functioning correctly?"}
    box_14["Verify that the vacuum holds the mounted part<br/>securely; if not, check whether the suction force is<br/>insufficient."]
    box_15[/"Vacuum part present detection diagnostic"/]
    box_16{"Are the correct end stops mounted?"}
    box_17["Identify which of the three end stop configurations<br/>is required."]
    box_18["Identify and mount the correct end stop<br/>configuration for the current product type."]
    box_19{"Are the linear guides clean and greased?"}
    box_20["Confirm that the linear guides are lightly greased<br/>according to manufacturer specifications."]
    box_21["Clean the linear guides and apply light grease<br/>according to the manufacturer's lubrication<br/>specification."]
    box_22{"Are the sensors of the actuators functioning?"}
    box_23["Complete the following checks: 1. Verify that the<br/>sensor illuminates when the actuator reaches its end<br/>position. 2. Check controller inputs for cable<br/>breaks."]
    box_24["Replace the faulty actuator end position sensor."]
    box_25{"Do the pressing heads meet the drawing?"}
    box_26["Check for wear marks and check tolerances according<br/>to drawing"]
    box_27["Replace the pressing heads with new ones that meet<br/>the dimensional tolerances specified in the drawing."]
    box_28{"Is there play in the linear bearing?"}
    box_29["Check the lateral play during unloaded state of<br/>actuator"]
    box_30["Replace the linear bearing showing excessive lateral<br/>play."]
    box_31{"Is the actuator leaking?"}
    box_32["Check the actuators for air leakage in both<br/>positions."]
    box_33["Replace the leaking actuator."]
    box_34{"Is the actuator securely fastened?"}
    box_35["Check for secure fastening of actuator"]
    box_36["Refasten the actuator to eliminate looseness, using<br/>the specified torque setting."]
    box_37{"Actuator speed downward correct?"}
    box_38["Adjust the flow control valve to bring the actuator<br/>downward pressing speed to the specified value."]
    box_39{"End position of pressing head relative to vacuum<br/>fixture correct?"}
    box_40["Readjust the end position of the pressing head to<br/>achieve the correct lower position relative to the<br/>vacuum fixture."]
    box_41{"Pressing time according to spec?"}
    box_42["Readjust the pressing time setting on the controller<br/>to match the specified pressing duration."]
    box_43{"Set air pressure according to norm?"}
    box_44["Readjust the air pressure supply to the pressing<br/>station to match the specified operating pressure."]
    box_45{"Is the XY position of the pressing head relative to<br/>the part lifter correct?"}
    box_46["Notify the maintenance technician to realign the XY<br/>position of the pressing head relative to the part<br/>lifter."]
    box_47{"Is the vertical and horizontal parallelism of the<br/>pressing head relative to the fixture correct?"}
    box_48["Notify the maintenance technician to correct the<br/>vertical and horizontal parallelism of the pressing<br/>head relative to the fixture."]
    box_49{"Part height OK?"}
    box_50["Measure the part height using a depth gauge and<br/>compare against the specification."]
    box_51[/"Part height adjustment procedure"/]
    box_52{"Height measurement correct?"}
    box_53["Confirm that all pressing parameters are within<br/>specification and proceed to force measurement<br/>verification."]
    box_54[/"Height gauge zeroing procedure"/]
    box_55{"Force measurement correct?"}
    box_56["Replace signal cable between gauge and amplifier."]
    box_57[/"Force sensor calibration procedure at pressing<br/>station"/]
    box_58["Repeat the diagnostic procedure from the beginning."]
    box_59(["Pressing part is correct"])

