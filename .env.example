# DIAGFLOWBENCH — API Keys & Configuration
# Copy this file to .env and fill in your keys.
# .env is gitignored and will never be committed.

# OpenRouter — used for the multi-model evaluation phase only.
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Separate OpenRouter key for the LLM-as-judge (keeps judge traffic off the
# evaluation key so concurrent runs don't compete for rate limits).
JUDGE_API_KEY=sk-or-...

# Direct Anthropic key — REQUIRED for conversation generation.
# Used for both the synchronous pipeline (run_generation.py) and
# the Batch API pipeline (run_batch_generation.py).
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Generation Models
# Must be a valid Anthropic model ID with optional 'anthropic/' prefix.
# The batch pipeline strips the prefix automatically.
# Examples:
#   anthropic/claude-sonnet-4-20250514  (default, recommended)
#   anthropic/claude-opus-4-20250514    (higher quality, ~5x cost)
#   anthropic/claude-3-5-haiku-20241022 (faster, lower cost)
GENERATION_MODEL=anthropic/claude-sonnet-4-5

# Temperature for Pass-1 generation (0.0 = deterministic, 0.7 = creative).
# The released dataset was generated at 0.7.
GENERATION_TEMPERATURE=0.7

# Verification model for Pass-2. Defaults to GENERATION_MODEL if unset, which
# matches how the released dataset was built (Pass-2 runs at temperature 0.0
# regardless of which model is set here, so determinism does not require a
# different model).
# VERIFICATION_MODEL=anthropic/claude-sonnet-4-5
